#!/usr/bin/env bash
# Run a WORKING COPY of ai-mirror on the desktop host, inside the installed
# package's environment. The bare interpreter there has no AT-SPI bindings, so
# `a11y_*` fails with "Namespace Atspi not available"; sourcing the packaged
# wrapper's exports borrows its typelibs, and PYTHONPATH puts the working copy
# ahead of the shipped library.
#
# Deploy the copy first:  rsync -a src/ai_mirror/ "$HOST":/tmp/aim/ai_mirror/
#
# Everything is resolved from the wrapper on the host at call time -- a store
# path written down here is wrong after the next rebuild, which is how the
# first version of this script broke.
HOST="${AI_MIRROR_HOST:-razer}"
args=$(printf ' %q' "$@")
exec ssh -o BatchMode=yes -o ConnectTimeout=8 "$HOST" \
  "export XDG_RUNTIME_DIR=/run/user/1000;
   export HYPRLAND_INSTANCE_SIGNATURE=\$(ls -t /run/user/1000/hypr | head -1);
   export WAYLAND_DISPLAY=\$(ls /run/user/1000 | grep -m1 '^wayland-[0-9]');
   wrapper=\$(readlink -f \"\$(command -v ai-mirror)\") || exit 1;
   # the wrapper is export lines then one exec; take the exports, and the
   # interpreter out of the exec, rather than hardcoding either
   source <(grep -E '^(export |[A-Z_]+=)' \"\$wrapper\");
   python=\$(sed -n 's|^exec \"\\(/nix/store/[^\"]*\\)\".*|\\1|p' \"\$wrapper\" | head -1);
   export PYTHONPATH=/tmp/aim:\${PYTHONPATH:-};
   exec \"\$python\" -m ai_mirror$args"
