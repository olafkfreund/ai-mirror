#!/usr/bin/env bash
# Run a WORKING COPY of ai-mirror on the desktop host, inside the installed
# package's environment. The bare interpreter there has no AT-SPI bindings, so
# `a11y_*` fails with "Namespace Atspi not available"; sourcing the packaged
# wrapper's exports borrows its typelibs, and PYTHONPATH puts the working copy
# ahead of the shipped library. Deploy first:  rsync -a src/ai_mirror/ host:/tmp/aim/ai_mirror/
# The two store paths are this host's; re-read them from `readlink -f $(command -v ai-mirror)`.
args=$(printf ' %q' "$@")
exec ssh -o BatchMode=yes -o ConnectTimeout=8 razer \
  "export XDG_RUNTIME_DIR=/run/user/1000;
   export HYPRLAND_INSTANCE_SIGNATURE=\$(ls -t /run/user/1000/hypr | head -1);
   export WAYLAND_DISPLAY=\$(ls /run/user/1000 | grep -m1 '^wayland-[0-9]');
   export AI_MIRROR_DEV=/tmp/aim;
   source <(sed -n '2,42p' /nix/store/vvx4ckbak6czsrz1z9s58yyyrd279lxs-ai-mirror-2.0.0/bin/ai-mirror);
   export PYTHONPATH=/tmp/aim:\$PYTHONPATH;
   exec /nix/store/4s1ip5kfdmhsk4ldkmm25hjm5hsk6hwx-python3-3.14.7-env/bin/python3 -m ai_mirror$args"
